# Optional. Without it, transfers come from Blockscout (free, no key).
# With it, Etherscan v2 multichain is used for every chain (note: Etherscan's free tier
# excludes some L2s such as Base/Optimism — Blockscout is the safer default).
ETHERSCAN_API_KEY=

# LEDGER_PORT=4100
# LEDGER_DB=./data/ledger.db
